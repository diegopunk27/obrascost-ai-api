# API Keys — at least one service must be configured
GROQ_API_KEY=your_groq_api_key_here
CEREBRAS_API_KEY=your_cerebras_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Models (optional — sensible defaults are used if not set)
GROQ_MODEL=llama-3.3-70b-versatile
CEREBRAS_MODEL=llama3.1-8b
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Optional metadata sent to OpenRouter headers (for usage dashboards)
OPENROUTER_SITE_URL=http://localhost
OPENROUTER_SITE_NAME=Bun AI Load Balancer

# Server configuration
PORT=8080

# Environment
NODE_ENV=development
